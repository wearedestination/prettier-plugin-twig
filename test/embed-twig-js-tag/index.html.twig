It should pretty print pure JS inside a js tag
printWidth: 20
embeddedSingleQuote: false
{% js %}
function main(){console.log("hello");}const x = 100 > 42 ? x : y;
{% endjs %}

It should fallback to reindenting when it can't parse the source
(e.g. because of Twig in JS)
printWidth: 20
{% js %}
function main(){console.log({{ drop }});}const x = 100 > 42 ? x : y;
{% endjs %}

It should reindent when it can't parse and change spaces to tabs with useTabs
printWidth: 20
useTabs: true
{% js %}
  function main(){
    console.log({{ drop }});
  }
  const x = 100 > 42 ? x : y;
{% endjs %}

It should respect embeddedSingleQuote
embeddedSingleQuote: true
{% js %}
console.log("hi");
{% endjs %}

It should not swallow content after a standalone tag
{% js 'app.js' %}
<p>hello</p>
{% js %}
foo( )
{% endjs %}

It should keep line comments on their own line
{% js %}
// hi
foo( )
{% endjs %}

It should not format Twig output as JS blocks
{% js %}
{{ output }}
{% endjs %}

It should not reindent template literals next to Twig
{% js %}
   foo(`a
     b`, {{ x }})
{% endjs %}

It should support the script tag
{% script 'app.js' at 'bottom' %}
<p>hello</p>
{% script with { type: 'module' } %}
// hi
foo( )
{% endscript %}

It should not format markup as JSX
{% js %}
<script>
  // hi
  foo( )
</script>
{% endjs %}
{% script %}
// comment
/* other */
<script src="a.js"></script>
{% endscript %}

It should ignore commented out opening tags in the body
{% js %}
{# {% js 'old.js' %} #}
// hi
foo( )
{% endjs %}

It should format the arguments like those of standalone tags
<div>
{% js "a.js" %}
foo( )
{% endjs %}
{% js with {
  type: "module",
} %}
foo( )
{% endjs %}
</div>

It should support opening comment delimiters that aren't comments
{% js %}
class A {#x=1}
{% endjs %}
<p>{# comment #}</p>
{% js %}
{% verbatim %}class A {#x=1}{% endverbatim %}
// hi
{% endjs %}
{% js %}
foo( )
{% endjs %}
{# comment #}
