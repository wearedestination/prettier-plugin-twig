It should pretty print pure JS inside a js tag
printWidth: 20
embeddedSingleQuote: false
{% js %}
function main(){console.log("hello");}const x = 100 > 42 ? x : y;
{% endjs %}

It should fallback to reindenting when it can't parse the source
(e.g. because of Twig in JS)
printWidth: 20
{% js %}
function main(){console.log({{ drop }});}const x = 100 > 42 ? x : y;
{% endjs %}

It should reindent when it can't parse and change spaces to tabs with useTabs
printWidth: 20
useTabs: true
{% js %}
  function main(){
    console.log({{ drop }});
  }
  const x = 100 > 42 ? x : y;
{% endjs %}

It should respect embeddedSingleQuote
embeddedSingleQuote: true
{% js %}
console.log("hi");
{% endjs %}

It should not swallow content after a standalone tag
{% js 'app.js' %}
<p>hello</p>
{% js %}
foo( )
{% endjs %}

It should keep line comments on their own line
{% js %}
// hi
foo( )
{% endjs %}

It should not format Twig output as JS blocks
{% js %}
{{ output }}
{% endjs %}

It should not reindent template literals next to Twig
{% js %}
   foo(`a
     b`, {{ x }})
{% endjs %}

It should support the script tag
{% script 'app.js' at 'bottom' %}
<p>hello</p>
{% script with { type: 'module' } %}
// hi
foo( )
{% endscript %}

It should not format markup as JSX
{% js %}
<script>
  // hi
  foo( )
</script>
{% endjs %}
{% script %}
// comment
/* other */
<script src="a.js"></script>
{% endscript %}

It should ignore commented out opening tags in the body
{% js %}
{# {% js 'old.js' %} #}
// hi
foo( )
{% endjs %}

It should format the arguments like those of standalone tags
<div>
{% js "a.js" %}
foo( )
{% endjs %}
{% js with {
  type: "module",
} %}
foo( )
{% endjs %}
</div>

It should support opening comment delimiters that aren't comments
{% js %}
class A {#x=1}
{% endjs %}
<p>{# comment #}</p>
{% js %}
{% verbatim %}class A {#x=1}{% endverbatim %}
// hi
{% endjs %}
{% js %}
foo( )
{% endjs %}
{# comment #}

It should support the position of a script
{% js at head %}
foo( )
{% endjs %}
{% js on ready %}
foo( )
{% endjs %}
{% js "app.js" at endBody with {defer: true} %}
<p>hello</p>

It should format modules
{% script with {type: 'module'} %}
import a from './a.js';
await a( );
{% endscript %}

It should format JSON
{% script with {type: 'application/ld+json'} %}
[{"@type":"Person"}]
{% endscript %}
{% script with {defer: true, "type": "importmap"} %}
{"imports":{}}
{% endscript %}
{% script with {type: 'application/json'} %}
{{ data|json_encode|raw }}
{% endscript %}

It should format TypeScript
{% script with {type: 'application/x-typescript'} %}
const a:string='b'
{% endscript %}

It should only reindent scripts whose type isn't known
{% script with {type: 'text/plain'} %}
foo - bar
{% endscript %}
{% script with {type: someType} %}
foo - bar
{% endscript %}
{% script with attributes %}
foo - bar
{% endscript %}
{% script with {a: b, ...attributes} %}
foo - bar
{% endscript %}
{% script with {a: b}|merge(attributes) %}
foo - bar
{% endscript %}
{% script with {type: 'module', data: {type: 'text/plain'}} %}
foo - bar
{% endscript %}

It should not reindent template literals when the type isn't known
<div>
{% script with attributes %}
const a = `
  b`;
{% endscript %}
</div>

It should format scripts that only contain Twig in strings
{% js %}
foo( '{{ x }}' )
{% endjs %}
