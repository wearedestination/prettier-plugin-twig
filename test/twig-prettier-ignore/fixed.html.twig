It should respect the html prettier-ignore comment
printWidth: 1
<!-- prettier-ignore -->
{{ a|b|c }}

It should respect the html prettier-ignore comment on tags
printWidth: 1
<a>
  <!-- prettier-ignore -->
  <b>{{ a|b|c }}</b
  >hi
</a>

It should respect the html prettier-ignore comment on twig tags
printWidth: 1
<a>
  <!-- prettier-ignore -->
  {%block foo%}{% for x in (0 .. 1) %}{{ a|b|c }}{% endfor %}{%endblock%}
</a>

It should respect the twig prettier-ignore comment
printWidth: 1
{# prettier-ignore #}
{{ a|b|c }}

It should respect the twig prettier-ignore comment on tags
printWidth: 1
<a>
  {# prettier-ignore #}
  <b>{{ a|b|c }}</b
  >hi
</a>

It should respect the twig prettier-ignore comment on twig tags
printWidth: 1
<a>
  {# prettier-ignore #}
  {%block foo%}{% for x in (0 .. 1) %}{{ a|b|c }}{% endfor %}{%endblock%}
</a>

It should respect the twig prettier-ignore comment on tags (and maintain whitespace semantic meaning)
printWidth: 1
<a>
  {# prettier-ignore #}
  {%block foo%}{% for x in (0 .. 1) %}{{ a|b|c }}{% endfor %}{%endblock%}
  {{- 'hi' }}
</a>
